rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Luqman Fabrics E-Commerce Security Rules
    // Allows guest customers to place orders and lookup their tracking info
    // Allows real-time sync for catalog and store configuration
    
    match /orders/{orderId} {
      allow read, write: if true;
    }
    
    match /products/{productId} {
      allow read, write: if true;
    }
    
    match /settings/{settingId} {
      allow read, write: if true;
    }
    
    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
